# ==============================================================================
# AI Gateway Configuration Template
# Copy this file to .env and adjust values for your environment.
# .env is strictly ignored by git to protect credentials.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Default CLI Backend: agy | claude | copilot
DEFAULT_BACKEND=agy

# Authentication & Security
# Comma-separated list of bearer tokens required for /api access.
# If left empty, API is open without authentication.
GATEWAY_TOKENS=generate-a-secure-random-token-here

# Flask Session Security Key
SECRET_KEY=generate-a-random-hex-secret-here

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Uploads & Temporary File Lifetimes
UPLOAD_DIR=~/.gemini_uploads
UPLOAD_TTL_SECONDS=21600
MAX_FILE_SIZE=52428800

# Optional Server Deployment Settings (SSH remote deployments)
PROD_HOST=
PROD_USER=
PROD_PASS=
