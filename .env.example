# ==============================================================================
# AI Gateway configuration. install.sh copies this to .env and fills in a token.
# .env is ignored by git. Only the settings below are read by the gateway.
# ==============================================================================

# Address and port for start.sh / the `ai-gateway` command (gunicorn).
# The systemd service always binds 0.0.0.0:5000; edit its ExecStart line to change that.
HOST=0.0.0.0
PORT=5000

# CLI used when a request doesn't name one: agy | claude | copilot
DEFAULT_BACKEND=agy

# Comma-separated access tokens. Every /api call except /api/auth/status must send one
# (Authorization: Bearer <token>, X-Gateway-Token: <token>, or ?token=<token>).
# Leave empty to run with no access control (the gateway prints a warning).
GATEWAY_TOKENS=generate-a-secure-random-token-here

# Websites allowed to call the API from a browser (comma-separated), or * for any.
CORS_ORIGINS=*

# Uploaded files older than this many seconds are deleted (default 6 hours).
UPLOAD_TTL_SECONDS=21600

# Where the agy account pool lives (default ~/.gemini_accounts).
# AGY_ACCOUNTS_DIR=

# Only for `python manage_accounts.py sync-to-prod`
PROD_HOST=
PROD_USER=
PROD_PASS=
# Token for the production gateway's API (defaults to the first GATEWAY_TOKENS entry above)
PROD_GATEWAY_TOKEN=
